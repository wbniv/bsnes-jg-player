# Emscripten SDK (bootstrapped by build.sh — reproducible, not vendored)
/emsdk/

# Android public release signing material is materialized here from AWS SSM.
/.private/

# Upstream core checkout (cloned by build.sh at a pinned commit)
/vendor/

# Built core artifacts (reproducible via build.sh)
/web/cores/*.wasm
/web/cores/*.js
/web/cores/*.data
/web/cores/*.bc
/web/cores/PROVENANCE.json

# Deferral-tracking hook state
/docs/plans/.deferrals-seen

# Deploy bundle (reproducible via deploy-bundle.sh)
/dist-bundle/

# Android TV app build products (APK is staged explicitly when delivered)
/android-tv/.gradle/
/android-tv/local.properties
/android-tv/app/build/
/android-tv/app/.cxx/
/android-tv/app/.externalNativeBuild/

# Generated iOS project, verified dependencies, and CI evidence.
/ios/generated/
/ios/build/
/ios/artifacts/

# Misc
*.log
.DS_Store
node_modules/
__pycache__/
/.claude/memory/
